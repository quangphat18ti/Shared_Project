  "tabAutocompleteModel": {
    "title": "Qwen2.5-Coder-1.5B (Autocomplete)",
    "provider": "ollama",
    "model": "qwen2.5-coder:1.5b",
    "apiBase": "http://localhost:11434",
    "contextLength": 4096,
    "completionOptions": {
      "temperature": 0.05,
      "topP": 0.75,
      "topK": 20,
      "numPredict": 128,
      "numThread": 8,
      "stop": ["\n\n", "//", "/*", "func ", "type ", "var ", "const ", "package ", "import "]
    }
  },
  "tabAutocompleteOptions": {
    "debounceDelay": 300,
    "maxPromptTokens": 1024,
    "prefixPercentage": 0.5,
    "maxSuffixPercentage": 0.25,
    "disableInFiles": ["*.md", "*.txt", "*.json"]
  },
  "embeddingsProvider": {
    "provider": "ollama",
    "model": "nomic-embed-text",
    "apiBase": "http://localhost:11434"
  },
  "reranker": {
    "name": "llm",
    "params": {
      "modelTitle": "Qwen2.5-Coder-3B (Fast Chat)"
    }
  },
  "customCommands": [
