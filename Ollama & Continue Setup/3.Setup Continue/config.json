    },
    {
      "name": "deep-review",
      "prompt": "Comprehensive Go code review:\n1. Error handling patterns\n2. Context usage and cancellation\n3. Goroutine safety\n4. MongoDB optimization\n5. Memory leaks\n6. Architecture improvements\n\n{{{ input }}}",
      "description": "Deep analysis (uses 7B model - slower)",
      "modelTitle": "Qwen2.5-7B (Advanced - Use Sparingly)"
    },
    {
      "name": "fix-quick",
      "prompt": "Fix this code issue quickly:\n{{{ input }}}",
